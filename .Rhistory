library(gh)
library(usethis)
library(tools)
library(jsonlite)
library(httr)
#Read metadata
metadata <- fromJSON("Input/sources.json", simplifyVector = TRUE)
species.metadata <- metadata$species_sources
#Create release version
release.version <- format(Sys.Date(),"%Y.%m")
#Create release description string
description.string <- "SQLite annotation databases for geneslator package (https://github.com/knowmics-lab/geneslator)"
description.string <- paste0(description.string,"\n\nIncluded organisms:\n")
for(i in 1:nrow(species.metadata)){
description.string <- paste0(description.string,"\n",species.metadata[i,"official_name"]," (",
species.metadata[i,"species"],")")
}
#Rename databases
list.databases <- list.files("Output",pattern = "eg\\.sqlite$")
for(db in list.databases){
file.rename(from=paste0("Output/",db),
to=paste0("Output/",gsub(".eg.",".db.",db,fixed=T)))
}
#Create databases JSON file
databases.json <- data.frame(Name=character(),Organism=character(),TaxID=integer(),MD5=character())
for(i in 1:nrow(species.metadata)){
db.name <- strsplit(species.metadata[i,"official_name"]," ")[[1]]
db.name <- paste0("org.",substr(db.name[1],1,1),db.name[2],".db")
org.name <- species.metadata[i,"official_name"]
taxid <- species.metadata[i,"taxid"]
md5 <- unname(md5sum(paste0("Output/",db.name,".sqlite")))
databases.json <- rbind(databases.json,data.frame(Name=db.name,Organism=org.name,TaxID=taxid,MD5=md5))
}
writeLines(toJSON(databases.json, pretty = TRUE, auto_unbox = TRUE),"Output/databases.json")
#Create release
new_rel <- gh("POST /repos/:owner/:repo/releases", owner = "knowmics-lab", repo = "geneslator-data",
tag_name = release.version, name = paste0("Geneslator version ",release.version), body = description.string)
#Extract URL
upload.url <- gsub("\\{[^\\}]+\\}","",new_rel$upload_url)
#Upload files
files.to.upload <- list.files("Output")
for(file in files.to.upload){
print(paste0("Uploading file ",file,"..."))
#Read file as binary file
file.path <- paste0("Output/",file)
raw.data <- readBin(file.path,"raw",file.info(file.path)$size)
# Upload del file
upload.endpoint <- paste0(upload.url, "?name=", basename(file.path))
res <- POST(
url = upload.endpoint,
add_headers(
Authorization = paste("token", Sys.getenv("GITHUB_PAT")),
`Content-Type` = "application/octet-stream"
),
body = upload_file(file.path), # Caricamento diretto e sicuro
encode = "raw"
)
}
library(jsonlite)
library(zen4R)
library(tools)
#Read metadata
metadata <- fromJSON("Input/sources.json", simplifyVector = TRUE)
species.metadata <- metadata$species_sources
#Create release version
release.version <- format(Sys.Date(),"%Y.%m")
#Create release description string
description.string <- "SQLite annotation databases for geneslator package (https://github.com/knowmics-lab/geneslator)"
description.string <- paste0(description.string,"\n\nIncluded organisms:\n")
for(i in 1:nrow(species.metadata)){
description.string <- paste0(description.string,"\n",species.metadata[i,"official_name"]," (",
species.metadata[i,"species"],")")
}
#Rename databases
list.databases <- list.files("Output",pattern = "eg\\.sqlite$")
for(db in list.databases){
file.rename(from=paste0("Output/",db),
to=paste0("Output/",gsub(".eg.",".db.",db,fixed=T)))
}
#Create databases JSON file
databases.json <- data.frame(Name=character(),Organism=character(),TaxID=integer(),MD5=character())
for(i in 1:nrow(species.metadata)){
db.name <- strsplit(species.metadata[i,"official_name"]," ")[[1]]
db.name <- paste0("org.",substr(db.name[1],1,1),db.name[2],".db")
org.name <- species.metadata[i,"official_name"]
taxid <- species.metadata[i,"taxid"]
md5 <- unname(md5sum(paste0("Output/",db.name,".sqlite")))
databases.json <- rbind(databases.json,data.frame(Name=db.name,Organism=org.name,TaxID=taxid,MD5=md5))
}
#Configure access to Zenodo account
zenodo.token <- "xxcZXqtB4OvEU2wu11ORq3Q621sTARIkaMkbanFsTlf4KQZbvsJKk6ihPkLe"
zenodo.concept.doi <- "10.5281/zenodo.20448208"
zenodo <- ZenodoManager$new(token=zenodo.token)
#Recupera l'ultima versione e crea una nuova versione del record
record <- zenodo$getRecordByConceptDOI(zenodo.concept.doi)
record
new_record <- zenodo$depositRecordVersion(record)
new_record$setTitle(paste0("Geneslator version ", release.version))
new_record$setVersion(release.version)
#new_record$setDescription(description.string)
new_record$setPublicationDate(format(Sys.Date(), "%Y-%m-%d"))
new_record
zenodo$depositRecord(new_record)
new_record <- zenodo$depositRecord(new_record)
# Carica i file
files.to.upload <- list.files("Output", full.names = TRUE)
for (file.path in files.to.upload) {
message("Uploading file ", basename(file.path), "...")
zenodo$uploadFile(file.path, record = new_record)
}
# Pubblica la nuova versione
zenodo$publishRecord(new_record$id)
message("Pubblicato su Zenodo versione ", release.version)
